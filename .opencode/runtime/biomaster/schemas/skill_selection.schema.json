{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["selected_route_id", "selected_skill_ids", "rejected_skill_ids", "reason"],
  "properties": {
    "selected_route_id": { "type": ["string", "null"] },
    "candidate_skill_ids": { "type": "array", "items": { "type": "string" } },
    "selected_skill_ids": { "type": "array", "items": { "type": "string" } },
    "rejected_skill_ids": { "type": "array", "items": { "type": "string" } },
    "reason": { "type": "string" }
  }
}
