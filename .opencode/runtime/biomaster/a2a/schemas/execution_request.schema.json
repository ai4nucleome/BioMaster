{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["message_type", "from", "to", "run_id", "phase", "payload"],
  "properties": {
    "message_type": { "const": "execution_request" },
    "payload": {
      "type": "object",
      "required": ["plan_path", "start_step"],
      "properties": {
        "plan_path": { "type": "string" },
        "start_step": { "type": "string" }
      }
    }
  }
}
