{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["message_type", "from", "to", "run_id", "phase", "payload"],
  "properties": {
    "message_type": { "const": "debug_result" },
    "payload": {
      "type": "object",
      "required": ["step_id", "status"],
      "properties": {
        "step_id": { "type": "string" },
        "status": { "type": "string" },
        "proposed_fix": { "type": "string" },
        "retry_plan": { "type": "object" }
      }
    }
  }
}
