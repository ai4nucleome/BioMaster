{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["message_type", "from", "to", "run_id", "phase", "payload"],
  "properties": {
    "message_type": { "const": "intake_request" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "run_id": { "type": "string" },
    "phase": { "const": "mode_selection" },
    "payload": {
      "type": "object",
      "required": ["user_goal"],
      "properties": {
        "user_goal": { "type": "string" },
        "mode": { "enum": ["test", "formal", "custom"] }
      }
    }
  }
}
