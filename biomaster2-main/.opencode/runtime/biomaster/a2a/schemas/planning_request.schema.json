{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["message_type", "from", "to", "run_id", "phase", "payload"],
  "properties": {
    "message_type": { "const": "planning_request" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "run_id": { "type": "string" },
    "phase": { "type": "string" },
    "payload": { "type": "object" },
    "required_outputs": { "type": "array", "items": { "type": "string" } }
  }
}
