{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biomaster.local/schemas/plan_step.schema.json",
  "title": "BioMaster PLAN.yaml Step",
  "type": "object",
  "required": [
    "step_id",
    "objective",
    "required_execute_skills",
    "required_verify_skills",
    "expected_outputs",
    "acceptance_criteria"
  ],
  "properties": {
    "step_id": {
      "type": "string",
      "pattern": "^[0-9]{2}_[a-z0-9_]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "required_execute_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^exec-[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "required_verify_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^verify-[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
