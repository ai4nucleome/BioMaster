{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["run_id", "phase"],
  "properties": {
    "run_id": { "type": "string" },
    "phase": { "type": "string" },
    "mode": { "type": "string" },
    "domain": { "type": "string" },
    "discipline": { "type": "string" },
    "pipeline": { "type": "string" },
    "selected_route_id": { "type": "string" },
    "selected_skill_ids": { "type": "array", "items": { "type": "string" } },
    "disabled_skill_ids": { "type": "array", "items": { "type": "string" } }
  }
}
