{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "biomaster-plan": {
      "description": "Primary BioMaster agent. Collects goals, selects project context, routes through SQLite, generates PLAN.yaml, and coordinates worker agents.",
      "mode": "primary",
      "temperature": 0.1,
      "prompt": "{file:agents/biomaster-plan.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": false
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "deny"
        }
      }
    },
    "biomaster-execute": {
      "description": "BioMaster work agent. Executes one PLAN step at a time with exec-* and env-* skills.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:agents/biomaster-execute.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask"
        }
      }
    },
    "biomaster-check": {
      "description": "Subagent that verifies step outputs using verify-* skills and maintains CHECK_REPORT.yaml.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:agents/biomaster-check.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask"
        }
      }
    },
    "biomaster-debug": {
      "description": "Subagent that diagnoses failed steps and proposes bounded retry plans.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:agents/biomaster-debug.md}",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask"
        }
      }
    },
    "biomaster-skiller": {
      "description": "Skill router. Decides which BioSkills layer (macro/micro) each sub-agent sees and fetches it via the bioskills tool.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:agents/biomaster-skiller.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "bioskills": true
      },
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    },
    "biomaster-skill-author": {
      "description": "Skill curator. Evaluates raw material and (re)divides it into a curated macro/micro + structured-steps BioSkill via the bioskills-author tool.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:agents/biomaster-skill-author.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "bioskills": true,
        "bioskills-author": true
      },
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        }
      }
    },
    "biomaster-skill-creator": {
      "description": "Skill generator. Synthesizes a brand-new curated BioSkill from a paper / URL / GitHub repo plus a required skill-focus description, fetching source material with webfetch and writing via the bioskills-author tool.",
      "mode": "subagent",
      "temperature": 0.2,
      "prompt": "{file:agents/biomaster-skill-creator.md}",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "webfetch": true,
        "bioskills": true,
        "bioskills-author": true
      },
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny"
        },
        "webfetch": "allow"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "biomaster": "allow"
    },
    "bash": {
      "*": "ask"
    },
    "edit": "ask"
  }
}
